# Laya voice assistant — copy to .env and edit

# LLM: leave empty to auto-detect (polaris :8080 → own llama-server → ollama)
# Or set explicitly: http://127.0.0.1:8080/v1
LLM_URL=

# GGUF for Laya's own thin llama-server spawn (auto: first match below)
LLM_MODEL=/mnt/backup/llm-models/Qwen3-4B-Q4_K_M.gguf
# llama-server binary (auto-detects common paths if empty)
LLAMA_SERVER_BIN=

# Decision gate: answers below this confidence fall back to LLM
GATE=0.50

# Voice for Kokoro TTS
TTS_VOICE=af_heart

# Polaris TTS fallback (optional): http://127.0.0.1:7802
POLARIS_TTS_URL=

# Interaction: ptt | wake | both  (default both)
MODE=both

# STT model size: tiny | base | small | medium
STT_MODEL=base

# Auto-start llama-server on boot of assistant (0/1)
# Default OFF on low-RAM machines — start manually or set 1 if you have ≥8GB free
LLM_AUTOSTART=0
